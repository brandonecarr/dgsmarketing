# ---------- Supabase (DB + Auth + Storage + Realtime) ----------
# Create a project at https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string from Supabase → Project Settings → Database → Connection String → URI
# Use the *pooled* (port 6543) URL for the app, *direct* (5432) for Drizzle migrations.
DATABASE_URL=
DIRECT_URL=

# ---------- AI ----------
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# https://platform.openai.com (used in Phase 2 for image generation)
OPENAI_API_KEY=

# ---------- Messaging (Phase 1) ----------
QUO_API_KEY=
OPENPHONE_API_KEY=

# ---------- Google (Phase 4) ----------
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: $NEXT_PUBLIC_APP_URL/api/integrations/google/callback
# Required scopes: openid, profile, email,
#   https://www.googleapis.com/auth/business.manage  (Google Business Profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Auto-Rosie scheduling (Phase 3) ----------
CRON_SECRET=

# ---------- Competitor scraping (Phase 4) ----------
META_AD_LIBRARY_TOKEN=

# ---------- Tinybird (Phase 11) ----------
# Push-mode events for tracking_clicks / page_views / usage_events.
# Optional — Postgres remains authoritative; Tinybird unlocks sub-second roll-ups
# at scale. Get a token at https://app.tinybird.co
TINYBIRD_TOKEN=
TINYBIRD_BASE_URL=https://api.tinybird.co

# ---------- Vapi voice (Phase 5) ----------
# Per-tenant keys live in integrations.secrets; this is only for shared defaults.
VAPI_API_BASE_URL=https://api.vapi.ai

# ---------- Stripe billing (Phase 6) ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE=price_xxx
STRIPE_PRICE_LLM_OVERAGE=
STRIPE_PRICE_SMS_OVERAGE=
STRIPE_PRICE_IMAGE_OVERAGE=

# Rough unit-cost references for the spend governor + cost ledger.
ROSIE_SMS_UNIT_COST_USD=0.01
ROSIE_IMAGE_UNIT_COST_USD=0.04

# ---------- Ad platforms (Phase 8) ----------
# Meta — create an app at https://developers.facebook.com/apps with Marketing API.
META_APP_ID=
META_APP_SECRET=

# Google Ads — re-uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above plus a
# Google Ads developer token: https://developers.google.com/google-ads/api/docs/first-call/dev-token
GOOGLE_ADS_DEVELOPER_TOKEN=

# TikTok — create an app in TikTok Business Center → Developer.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# ---------- Production hardening (Phase 7) ----------
# Required: master key for envelope-encrypting integrations.secrets at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ROSIE_ENCRYPTION_KEY=

# Transactional email (Resend). No-ops if unset.
RESEND_API_KEY=
RESEND_FROM="Rosie <rosie@notifications.yourdomain.com>"

# Rate limiting (Upstash Redis). No-ops if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error reporting (Sentry). No-ops if unset.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_RATE=0.1

# ---------- Maps & route optimization (customers + routes pages) ----------
# Geocode customer addresses + power the route map.
# Get a public token at https://account.mapbox.com/access-tokens — the same
# token works for both client (map) and server (geocoding + optimization).
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# ---------- Misc ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
